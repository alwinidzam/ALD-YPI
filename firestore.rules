rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // RBAC RULES (Enforced for Production)
    // -------------------------------------------------------------------------
    // Note: Since the preview uses a simulated login (App.tsx state), 
    // request.auth might be null. For the sake of the preview, we allow all,
    // but the following rules are the EXACT structural enforcement for RBAC.
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getRole() {
      return request.auth.token.role;
    }
    
    function isSuperAdmin() {
      return getRole() == 'SUPER_ADMIN';
    }
    
    function hasInstitutionAccess(institution) {
      return getRole() == 'SUPER_ADMIN' || getRole() == 'ADMIN_' + institution;
    }

    match /staff/{staffId} {
      allow read: if true; // In production, restrict to authenticated users
      allow write: if true; 
      /* Production Rule:
      allow write: if isAuthenticated() && (
        isSuperAdmin() || 
        hasInstitutionAccess(resource.data.primaryInstitution)
      );
      */
    }

    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
