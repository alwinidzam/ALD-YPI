{
  "entities": {
    "User": {
      "title": "User",
      "description": "Schema representing an authenticated operator in the ALD system",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "VIEWER", "ADMIN_SMA", "ADMIN_MTS", "ADMIN_MADIN", "ADMIN_TK", "ADMIN_PESANTREN", "ADMIN_SELAPANAN", "GURU", "STAFF"] },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "passwordHash": { "type": "string" },
        "contact": { "type": "string" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "photoURL": { "type": "string" },
        "dailyUploadCount": { "type": "integer" },
        "dailyDownloadCount": { "type": "integer" },
        "lastActionResetDate": { "type": "string" }
      },
      "required": ["id", "username", "name", "role", "status", "passwordHash"]
    },
    "DocumentMetadata": {
      "title": "DocumentMetadata",
      "description": "Schema representing digital report archives indexed in the system",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fileName": { "type": "string" },
        "category": { "type": "string", "enum": ["KEUANGAN", "KEGIATAN", "SURAT", "DOKUMEN", "LAINNYA", "SELAPANAN"] },
        "institution": { "type": "string", "enum": ["YPI", "SMA", "MTS", "MADIN", "TK", "PESANTREN"] },
        "year": { "type": "string" },
        "month": { "type": "string" },
        "description": { "type": "string" },
        "fileSize": { "type": "string" },
        "uploadDate": { "type": "string", "format": "date-time" },
        "uploader": { "type": "string" },
        "downloadCount": { "type": "integer" },
        "fileData": { "type": "string" }
      },
      "required": ["id", "fileName", "category", "institution", "year", "month", "description", "fileSize", "uploadDate", "uploader", "downloadCount"]
    },
    "DocumentChunk": {
      "title": "DocumentChunk",
      "description": "Schema representing a sliced chunk of a larger PDF document stored in Firestore to bypass the 1MB limit",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "docId": { "type": "string" },
        "chunkIndex": { "type": "integer" },
        "totalChunks": { "type": "integer" },
        "chunkData": { "type": "string" }
      },
      "required": ["id", "docId", "chunkIndex", "totalChunks", "chunkData"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Schema representing notices and bulletins broadcast by admins",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "priority": { "type": "string", "enum": ["LOW", "NORMAL", "HIGH", "URGENT"] },
        "targetRole": { "type": "string" },
        "visibility": { "type": "string", "enum": ["PUBLIC", "PRIVATE"] },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "EXPIRED"] },
        "createdBy": { "type": "string" },
        "createdByUsername": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string" },
        "attachment": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "type": { "type": "string", "enum": ["pdf", "jpg", "png"] },
            "fileSize": { "type": "string" },
            "fileData": { "type": "string" }
          },
          "required": ["name", "type"]
        }
      },
      "required": ["id", "title", "content", "priority", "targetRole", "startDate", "endDate", "status", "createdBy"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Schema representing administrative and critical system activity records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "username": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "ipAddress": { "type": "string" }
      },
      "required": ["id", "timestamp", "username", "name", "role", "action", "details", "ipAddress"]
    },
    "InstitutionProfile": {
      "title": "InstitutionProfile",
      "description": "Detailed profiling data for educational institutions, including teachers, board members, and classes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "leader": { "type": "string" },
        "totalStudents": { "type": "integer" },
        "totalTeachers": { "type": "integer" },
        "totalClasses": { "type": "integer" },
        "teachersList": { "type": "array" },
        "committeeList": { "type": "array" },
        "classList": { "type": "array" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "name", "type", "leader"]
    },
    "TeacherStaff": {
      "title": "TeacherStaff",
      "description": "Schema representing teachers and staff registered for barcode attendance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nip": { "type": "string" },
        "role": { "type": "string" },
        "institution": { "type": "string" },
        "contact": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "barcode": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "role", "institution", "barcode", "status"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Schema representing a single scanned barcode attendance check-in or check-out",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "role": { "type": "string" },
        "institution": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "type": { "type": "string", "enum": ["IN", "OUT"] },
        "status": { "type": "string", "enum": ["HADIR", "TERLAMBAT", "PULANG"] },
        "notes": { "type": "string" }
      },
      "required": ["id", "teacherId", "teacherName", "date", "time", "type", "status"]
    },
    "Report": {
      "title": "Report",
      "description": "Schema representing internal reports from Reporting Center",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "trackingCode": { "type": "string" },
        "type": { "type": "string", "enum": ["WHISTLEBLOWING", "COMPLAINT", "SUGGESTION"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["DRAFT", "SUBMITTED", "UNDER_VERIFICATION", "IN_PROGRESS", "NEED_INFO", "RESOLVED", "REJECTED"] },
        "identityOption": { "type": "string", "enum": ["PROTECTED", "OPEN"] },
        "reporterId": { "type": "string" },
        "reporterName": { "type": "string" },
        "reporterUsername": { "type": "string" },
        "reporterRole": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "conversation": { "type": "array" }
      },
      "required": ["id", "trackingCode", "type", "title", "description", "status", "identityOption", "reporterId", "reporterName", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles collection"
    },
    "documents/{docId}": {
      "schema": "DocumentMetadata",
      "description": "Indexed PDF metadata collection"
    },
    "documentChunks/{chunkId}": {
      "schema": "DocumentChunk",
      "description": "Base64 PDF file split segments"
    },
    "announcements/{annId}": {
      "schema": "Announcement",
      "description": "Broadcasting notices and news"
    },
    "audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Strict immutable ledger logs"
    },
    "institution_profiles/{profileId}": {
      "schema": "InstitutionProfile",
      "description": "Institutional detailed data, roster, class list, and leadership structure"
    },
    "teachers_staff/{teacherId}": {
      "schema": "TeacherStaff",
      "description": "Teachers and staff list for attendance tracking"
    },
    "attendance_logs/{logId}": {
      "schema": "AttendanceRecord",
      "description": "Scanned attendance records log"
    },
    "reports/{reportId}": {
      "schema": "Report",
      "description": "Reporting center submissions and tickets"
    }
  }
}
